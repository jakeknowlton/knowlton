# Opt-in formatting: ignore everything, then re-include the dirs that opt in.
# apps/api is left out — it's Python, formatted by Black.
/*

!/apps
/apps/*
!/apps/web
!/apps/mobile

!/packages
/packages/*
!/packages/api-client
!/packages/shared

# Build output and generated/vendored files within the opt-in dirs.
**/node_modules
**/dist
**/build
**/coverage
**/*.lock
**/generated.ts
